<!DOCTYPE html>

<html lang="en">

<head>

<title>My Animal Safari</title>

<meta charset="utf-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">

<style>
    .carousel-inner{
        text-align: center;
    }
.section{
    padding: 70px 20px;
    min-height: 300px;
}
#forest{
    background-color: aliceblue;
}
#ocean{
    background-color: antiquewhite;
}
#dessert{
    background-color: beige;
}
body{
    background-color: brown;
}
</style>

</head>

<body data-spy="scroll" data-target="navsafari">
    
<nav id="navsafari" class="navbar navbar-expand-sm navbar-dark bg-dark sticky-top">
    <a class="navbar-brand"
    href="#"> Safari guide  </a>
    <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" href="#forest">forest</a></li>
        <li class="nav-item"><a class="nav-link" href="#ocean">ocean</a></li>
        <li class="nav-item"><a class="nav-link" href="#dessert">dessert</a></li>
    </ul>
</nav>
<div class="container">

    <div id="forest" class="section">
        <h2>forest safari </h2>
        <p>explore tall trees and discover tigers, elephants and monkeys! </p>
    </div>

     <div id="ocean" class="section">
        <h2>ocean safari  </h2>
        <p>dive deep and meet dolphins, sharks and colorful clownfish! </p>
    </div>

     <div id="dessert" class="section">
        <h2>dessert  safari </h2>
        <p>trek across the sand dunes and spot camels, lizards and desset foxes! </p>
    </div>
</div>

<div class="carousel slide" id="safaricarousel" data-ride="carousel">
    <ol class="carousel-indicators">
        <li data-target="#safaricarousel" data-slide-to="1"></li>
         <li data-target="#safaricarousel" data-slide-to="2"></li>
         <li data-target="#safaricarousel" data-slide-to="3"></li>
    </ol>
<div class="carousel-inner">
<div class="carousel-item active">forest safari</div>
<div class="carousel-item">ocean safari</div>
<div class="carousel-item">dessert safari</div>
</div>
<a href="#safaricarousel" class="carousel-control-prev" data-slide="prev"><span class="carousel-control-prev-icon"></span></a>
<a href="#safaricarousel" class="carousel-control-next" data-slide="next"><span class="carousel-control-next-icon"></span></a>
</div>

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>

<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

</body>

</html>